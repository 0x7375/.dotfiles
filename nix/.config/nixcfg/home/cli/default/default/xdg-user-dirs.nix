{
  xdg.userDirs = {
    enable = true;
    createDirectories = true;
    download = "$HOME/downloads";
    documents = "$HOME/documents";
    pictures = "$HOME/pictures";
    videos = "$HOME/pictures/videos";
    extraConfig = {
      XDG_SCREENSHOTS_DIR = "$HOME/pictures/screenshots/linux";
    };
    desktop = "$HOME";
    templates = "$HOME";
    music = "$HOME";
    publicShare = "$HOME";
  };
}
